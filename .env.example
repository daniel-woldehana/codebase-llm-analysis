# Required for LLM mode
OPENAI_API_KEY=replace-me

# Model/provider configuration
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0

# Token and runtime controls
MAX_INPUT_TOKENS=12000
RESERVED_OUTPUT_TOKENS=1800
MAX_FILE_BYTES=300000
LLM_MAX_RETRIES=3
LLM_REQUEST_DELAY_SECONDS=0
CACHE_DIR=.analysis-cache
